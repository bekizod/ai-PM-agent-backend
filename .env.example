PORT=4000
GEMINI_API_KEY=your_google_ai_studio_gemini_key
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_target_repo_name

# Google Calendar Free API (Service Account or OAuth2)
GOOGLE_CLIENT_EMAIL=your_service_account_email
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary

# Nodemailer Free SMTP (Leave SMTP_USER blank to auto-use Ethereal test inbox with clickable preview links, or configure Gmail/Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL_FROM=ai-tpm-agent@example.com
NOTIFICATION_EMAIL_TO=kidus@brain3.ai
